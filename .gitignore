# ===========================
# AL SHAFI HOMEO STORE
# .gitignore
# ===========================

# Dependencies
node_modules/
**/node_modules/

# Environment variables (NEVER commit these!)
.env
**/.env
.env.local
.env.production
*.local.*
*personal*

# Database (SQLite - regenerated on deploy via seed)
server/data/*.db
server/data/*.db-journal

# Built frontend (Render will build this)
client/dist/

# Uploaded files (images uploaded by users/admin)
# NOTE: Product & doctor images are committed to git so they show on Render
# Only receipts & temp uploads are ignored
server/uploads/receipts/*
!server/uploads/receipts/.gitkeep
server/uploads/banners/*
!server/uploads/banners/.gitkeep
server/uploads/categories/*
!server/uploads/categories/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
logs/
*.log
npm-debug.log*

# Runtime
*.pid
*.seed
*.pid.lock

# Cache
.npm
.eslintcache
.cache/
