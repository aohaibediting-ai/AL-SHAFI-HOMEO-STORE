# =============================================================
# AL SHAFI HOMEO STORE - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================

# Server
PORT=5000
NODE_ENV=development

# JWT Secret - Generate a strong random string (minimum 32 characters)
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# Admin Account (used by seed script for initial setup)
ADMIN_EMAIL=admin@alshafihomeo.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_NAME=Store Admin

# Database
DATABASE_PATH=./data/store.db

# Upload settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Payment Gateway (configure when ready)
# PAYMENT_GATEWAY_KEY=
# PAYMENT_GATEWAY_SECRET=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Email notifications (configure when ready)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# SMS notifications (configure when ready)
# SMS_API_KEY=
# SMS_SENDER_ID=
